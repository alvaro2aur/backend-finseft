# Secretos: genéralos en el servidor (p. ej. `openssl rand -hex 24`). Nunca reutilices los de desarrollo.
POSTGRES_USER=finself_admin
POSTGRES_PASS=
APP_DB_PASS=
JWT_SECRET=

# Direcciones públicas desde las que se usa la app (separadas por coma) y la base de los enlaces por correo
PUBLIC_URLS=http://192.168.100.10:8090
APP_URL=http://192.168.100.10:8090
HTTP_PORT=8090
APP_TIMEZONE=America/Santiago
GOOGLE_CLIENT_ID=

# Tailscale Funnel (opcional): clave de autenticación creada en https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=finself
