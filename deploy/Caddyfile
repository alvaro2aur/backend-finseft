{
	# HTTPS lo pone el túnel (Tailscale Funnel); aquí solo HTTP interno.
	auto_https off
	servers {
		# Para conservar la IP real del cliente que entrega el túnel
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# API: /api/... → la API recibe la ruta sin el prefijo
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# Front (SPA): rutas desconocidas caen en index.html
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
