# Conexión de la API (rol sin BYPASSRLS; ver init-schema.sql)
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=fintseft
POSTGRES_SCHEMA=common
APP_DB_USER=finseft_app
APP_DB_PASS=

# Solo para recrear el schema y para las pruebas (superusuario)
POSTGRES_USER=
POSTGRES_PASS=

JWT_SECRET=
PORT=3000
# Orígenes permitidos por CORS, separados por coma ("*" = todos)
CORS_ORIGIN=*
# Base del enlace que se envía por correo (recuperar contraseña, invitaciones)
APP_URL=http://localhost:5173
# Para "Continuar con Google": client id de OAuth (sin él, POST /auth/google responde 501)
GOOGLE_CLIENT_ID=
# Zona horaria para "hoy" y "mes actual" en los resúmenes
APP_TIMEZONE=America/Santiago
